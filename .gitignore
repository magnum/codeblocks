# Products of ./configure and make.
# The files shipped in the source tree stay tracked: configure, Makefile.in,
# Makefile.am, aclocal.m4, config.h.in, *.pc.in and the libtool helpers.

# Autotools
Makefile
/libtool
/autom4te.cache/
/config.cache
/config.log
/config.status
/stamp-h1
**/stamp-h1

# Files written by configure from *.in
/bundle.sh
/codeblocks.pc
/codeblocks.plist
/codeblocks.spec
/codeblocks.spec.fedora
/debian/control
*.pc

# Generated by configure / the autorevision tool
/src/include/config.h
/src/include/autorevision.h
/.last_revision

# Libtool and compiler output
.deps/
.dirstamp
.libs/
*.a
*.dSYM/
*.dll
*.dylib
*.exe
*.gch
*.la
*.lai
*.lo
*.loT
*.o
*.obj
*.so
*.so.*

# Binaries produced in the build tree
/src/build_tools/autorevision/auto_revision
/src/src/codeblocks
/src/tools/ConsoleRunner/cb_console_runner
/src/tools/cb_share_config/cb_share_config

# In-tree IDE builds (src/update.bat and the Code::Blocks workspaces)
/src/.objs*/
/src/devel*/
/src/output*/

# Code::Blocks user files next to .cbp projects
*.depend
*.layout

# Debian package build leftovers
/debian/.debhelper/
/debian/files
/debian/*.debhelper
/debian/*.substvars

# Editor and OS leftovers
*~
*.swp
*.swo
.DS_Store
